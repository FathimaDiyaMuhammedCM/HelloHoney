PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hellohoney
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_32_PLUS_CHARACTERS
JWT_EXPIRES_IN=2h
FRONTEND_URL=http://localhost:5173
HONEYPOT_BIND=127.0.0.1
SSH_HONEYPOT_PORT=2222
HTTP_HONEYPOT_PORT=8080
BACKEND_URL=http://localhost:5000
INGEST_KEY=REPLACE_WITH_RANDOM_INGEST_KEY
SIMULATION_MODE=true

# User seeding (only used when SEED_DEFAULT_USERS=true)
# Never commit real passwords to version control
SEED_DEFAULT_USERS=false
SEED_ADMIN_PASSWORD=
SEED_ANALYST_PASSWORD=
SEED_VIEWER_PASSWORD=

# Demo security data seeding (only used when SEED_DEMO_DATA=true)
# Populates the dashboard with sample events/alerts/incidents when the DB is empty.
SEED_DEMO_DATA=false
